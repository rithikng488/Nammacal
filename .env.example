# ==========================================
# NammaCal Environment Configuration Template
# DO NOT COMMIT REAL SECRETS IN THIS FILE
# Copy this file to .env.local for local development
# ==========================================

# Public Supabase Client Configuration (Safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Private Server-Only Secrets (NEVER prefix with NEXT_PUBLIC_)
# Supabase Service Role Key: required for server-side invite verification & admin user creation
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Audit System Privacy Salt (Server-side only)
IP_HASH_SALT=your-ip-hashing-privacy-salt-here

# AI Provider Configuration (Server-side only)
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_TEXT_MODEL=gemini-2.5-flash

# AI Rate Limits (Requests per hour per user)
AI_PHOTO_RATE_LIMIT=20
AI_VOICE_RATE_LIMIT=30
AI_PARSE_RATE_LIMIT=60

# Media Retention Policy (0 = ephemeral zero-retention, >0 = retention in days)
MEDIA_RETENTION_DAYS=0
